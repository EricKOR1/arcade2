{
  "rules": {
    ".read": true,
    ".write": false,
    "session": {
      ".write": true
    },
    "finishCount": {
      ".write": true,
      ".validate": "newData.isNumber()"
    },
    "roster": {
      "$id": {
        ".write": true,
        ".validate": "newData.isString() && newData.val().length <= 12"
      },
      ".write": true
    },
    "players": {
      "$id": {
        ".write": true,
        "nickname": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "score": {
          ".validate": "newData.isNumber()"
        },
        "board": {
          ".validate": "!newData.exists() || newData.hasChildren() || (newData.isString() && newData.val().length <= 4000)"
        }
      },
      ".write": true
    },
    "pos": {
      "$id": {
        ".write": true,
        ".validate": "newData.isString() && newData.val().length <= 200"
      },
      ".write": true
    },
    "hazards": {
      ".write": true
    },
    "events": {
      ".write": true
    },
    "rooms": {
      ".write": true
    },
    "scores": {
      ".write": true
    },
    "screens": {
      "$id": {
        ".write": true,
        ".validate": "newData.isString() && newData.val().length <= 120000"
      },
      ".write": true
    },
    "finishes": {
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['ms'])"
      },
      ".write": true
    },
    "gems": {
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['x','y'])"
      },
      ".write": true
    },
    "picks": {
      "$id": {
        ".write": true,
        ".validate": "newData.isString() && newData.val().length < 20"
      },
      ".write": true
    }
  }
}